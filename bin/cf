#!/usr/bin/env node
// cf — Capital Factory helpers CLI.
//
//   cf connect            One-time interactive setup: install skills, sign in to union.vc + Slack,
//                         register the Pitch MCP server, then test everything. Run this first.
//   cf doctor             Re-test all auth (union.vc, Slack, Pitch) without signing in. Read-only.
//   cf report             Generate the mentor office-hours report into <CF_HOME>/reports/.
//   cf daily              Generate the report AND push it to your daily Slack target (no Claude).
//   cf calendar [...]      Pull the union.vc calendar as JSON (passes args to union_calendar.mjs).
//   cf slack <t> <msg...>  Send a Slack DM (passes args to slack.mjs dm; add --dry-run to preview).
//   cf mentors <sub>      Master mentor CSV: `show`, `set <path>`, or `search [flags]`.
//   cf knowledge <sub>    Local knowledge store: `show`, `set <path>`, `list [flags]`, `path <slug>`.
//   cf install-daily [HH:MM]   Install a launchd job that runs `cf daily` every day (default 07:00).
//   cf uninstall-daily    Remove that launchd job.
//   cf help               Show this help.
//
// No npm dependencies — Node built-ins only. The skills it drives DO need Playwright, installed
// by `cf connect`. Day-to-day report/Slack run with NO playwright; only the one-time
// browser sign-in (`union login` / `slack auth`) needs it.

import os from 'node:os';
import fs from 'node:fs';
import path from 'node:path';
import readline from 'node:readline';
import { spawn, spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

// ---------- paths ----------
const HOME = os.homedir();
const SELF = (() => { try { return fs.realpathSync(fileURLToPath(import.meta.url)); } catch { return fileURLToPath(import.meta.url); } })();
const REPO = path.resolve(path.dirname(SELF), '..');
const SKILLS_SRC = path.join(REPO, 'skills');
const SKILLS_DST = path.join(HOME, '.claude', 'skills');
const UNION_SCRIPTS = path.join(SKILLS_DST, 'union-calendar', 'scripts');
const SLACK_SCRIPTS = path.join(SKILLS_DST, 'slack-dm', 'scripts');
const UNION = path.join(UNION_SCRIPTS, 'union_calendar.mjs');
const MENTOR = path.join(UNION_SCRIPTS, 'mentor_report.mjs');
const SLACK = path.join(SLACK_SCRIPTS, 'slack.mjs');

// CF_HOME holds config.json + reports/ + augmentation/. Resolution order:
//   1. $CF_HOME                                              (explicit override)
//   2. nearest ancestor of CWD with `.cf-helpers/config.json` (a project workspace — see `cf init`)
//   3. ~/.cf-helpers                                         (the global default)
// This lets a project directory own its own memory/reports/augmentation while leaving global use
// (run from anywhere else) completely unchanged.
function findProjectHome(start) {
  let dir = path.resolve(start);
  for (;;) {
    const cand = path.join(dir, '.cf-helpers');
    if (fs.existsSync(path.join(cand, 'config.json'))) return cand;
    const parent = path.dirname(dir);
    if (parent === dir) return null;
    dir = parent;
  }
}
const CF_HOME = process.env.CF_HOME
  ? path.resolve(process.env.CF_HOME)
  : (findProjectHome(process.cwd()) || path.join(HOME, '.cf-helpers'));
const REPORT_DIR = path.join(CF_HOME, 'reports');
const AUGMENT_DIR = path.join(CF_HOME, 'augmentation');
const CF_CONFIG = path.join(CF_HOME, 'config.json');
const CLAUDE_JSON = path.join(HOME, '.claude.json');
const NPM_MCP_CACHE = path.join(HOME, '.npm-mcp-cache');

const SKILLS = ['union-calendar', 'slack-dm', 'slack-auth', 'cf-mentor-match', 'cf-augment', 'cf-pitch-roulette', 'cf-knowledge'];
const PITCH_PKG = '@capitalthought/pitch-mcp-server';

// ---------- tiny output helpers ----------
const C = process.stdout.isTTY
  ? { dim: (s) => `\x1b[2m${s}\x1b[0m`, b: (s) => `\x1b[1m${s}\x1b[0m`, g: (s) => `\x1b[32m${s}\x1b[0m`, r: (s) => `\x1b[31m${s}\x1b[0m`, y: (s) => `\x1b[33m${s}\x1b[0m`, c: (s) => `\x1b[36m${s}\x1b[0m` }
  : { dim: (s) => s, b: (s) => s, g: (s) => s, r: (s) => s, y: (s) => s, c: (s) => s };
const ok = (s) => console.log(`${C.g('✓')} ${s}`);
const warn = (s) => console.log(`${C.y('!')} ${s}`);
const bad = (s) => console.log(`${C.r('✗')} ${s}`);
const step = (s) => console.log(`\n${C.b(C.c('▸ ' + s))}`);

function readCfg() { try { return JSON.parse(fs.readFileSync(CF_CONFIG, 'utf8')); } catch { return {}; } }
function writeCfg(o) { fs.mkdirSync(CF_HOME, { recursive: true }); fs.writeFileSync(CF_CONFIG, JSON.stringify(o, null, 2) + '\n'); }

// run a command, inheriting stdio (for interactive / browser flows)
function runInherit(cmd, args, opts = {}) {
  const r = spawnSync(cmd, args, { stdio: 'inherit', ...opts });
  return r.status === 0;
}
// run a command, capturing output
function runCap(cmd, args, opts = {}) {
  const r = spawnSync(cmd, args, { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024, ...opts });
  return { ok: r.status === 0, status: r.status, out: r.stdout || '', err: r.stderr || '' };
}

function prompt(q) {
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  return new Promise((res) => rl.question(q, (a) => { rl.close(); res(a.trim()); }));
}
function promptHidden(q) {
  return new Promise((res) => {
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    process.stdout.write(q);
    rl._writeToOutput = () => {}; // mute echo so secrets don't hit the screen / scrollback
    rl.question('', (a) => { rl.close(); process.stdout.write('\n'); res(a.trim()); });
  });
}
async function confirm(q, def = true) {
  const a = (await prompt(`${q} ${def ? '[Y/n]' : '[y/N]'} `)).toLowerCase();
  if (!a) return def;
  return a === 'y' || a === 'yes';
}

// ---------- prerequisites ----------
function checkNode() {
  const major = parseInt(process.versions.node.split('.')[0], 10);
  if (major < 18) { bad(`Node ${process.versions.node} — need v18+. Install a newer Node and retry.`); return false; }
  ok(`Node ${process.versions.node}`);
  return true;
}

// ---------- install skills + deps ----------
function installSkills(force) {
  step('Installing skills into ~/.claude/skills');
  fs.mkdirSync(SKILLS_DST, { recursive: true });
  for (const name of SKILLS) {
    const src = path.join(SKILLS_SRC, name);
    const dst = path.join(SKILLS_DST, name);
    if (fs.existsSync(dst) && !force) { warn(`${name} already present — leaving it (use --force to overwrite)`); continue; }
    if (fs.existsSync(dst) && force) fs.rmSync(dst, { recursive: true, force: true });
    fs.cpSync(src, dst, { recursive: true });
    ok(`${name} installed`);
  }
}

function installDeps(force) {
  step('Installing Playwright (this can take a minute)');
  for (const dir of [UNION_SCRIPTS, SLACK_SCRIPTS]) {
    const nm = path.join(dir, 'node_modules');
    if (fs.existsSync(nm) && !force) { warn(`deps present in ${path.relative(HOME, dir)} — skipping npm install`); }
    else {
      console.log(C.dim(`  npm install in ${path.relative(HOME, dir)} …`));
      // Use a private npm cache to sidestep EACCES from a mixed-ownership ~/.npm (same trick the
      // Pitch MCP server uses). Without this, `npm install` fails on machines with a broken cache.
      const npmEnv = { ...process.env, NPM_CONFIG_CACHE: NPM_MCP_CACHE };
      if (!runInherit('npm', ['install', '--no-audit', '--no-fund'], { cwd: dir, env: npmEnv })) { bad(`npm install failed in ${dir}`); return false; }
    }
  }
  console.log(C.dim('  installing the Chromium browser for Playwright …'));
  if (!runInherit('npx', ['--yes', 'playwright', 'install', 'chromium'], { cwd: SLACK_SCRIPTS, env: { ...process.env, NPM_CONFIG_CACHE: NPM_MCP_CACHE } })) {
    warn('playwright browser install reported a problem — auth steps may fail until it succeeds');
  } else ok('Playwright + Chromium ready');
  return true;
}

// ---------- auth: union.vc ----------
function unionWorks() {
  if (!fs.existsSync(UNION)) return false;
  const r = runCap('node', [UNION, 'pull', '--weeks', '1']);
  if (!r.ok) return false;
  try { const j = JSON.parse(r.out); return Array.isArray(j.weeks); } catch { return false; }
}
async function unionAuth() {
  step('union.vc sign-in');
  if (unionWorks()) { ok('union.vc session already valid'); return true; }
  console.log('A browser window will open. Sign in to union.vc (Capital Factory), then it closes automatically.');
  await prompt(C.dim('Press Enter to open the sign-in window… '));
  runInherit('node', [UNION, 'login']);
  if (unionWorks()) { ok('union.vc connected'); return true; }
  bad('union.vc still not working after sign-in. Re-run `cf connect` or `node union_calendar.mjs login`.');
  return false;
}

// ---------- auth: slack ----------
function slackWhoami() {
  if (!fs.existsSync(SLACK)) return null;
  const r = runCap('node', [SLACK, 'auth-test']);
  if (!r.ok) return null;
  try { return JSON.parse(r.out); } catch { return null; }
}
async function slackAuth() {
  step('Capital Factory Slack sign-in');
  let who = slackWhoami();
  if (who && who.ok) { ok(`Slack session already valid (${who.user} @ ${who.team})`); }
  else {
    console.log('A browser window will open. Sign in to Capital Factory Slack, then it closes automatically.');
    await prompt(C.dim('Press Enter to open the sign-in window… '));
    runInherit('node', [SLACK, 'auth']);
    who = slackWhoami();
    if (who && who.ok) ok(`Slack connected (${who.user} @ ${who.team})`);
    else { bad('Slack still not working after sign-in. Re-run `cf connect` or `node slack.mjs auth`.'); return false; }
  }
  // Offer to set up the daily-report target (a self-DM is the common choice).
  const cfg = readCfg();
  if (!cfg.dailyTarget) {
    console.log(C.dim('\nThe daily report posts to one Slack target (a nickname or a raw conversation id).'));
    console.log(C.dim('A self-DM ("Messages to yourself") is the usual pick. To get its id: open it in Slack →'));
    console.log(C.dim('click a message timestamp → Copy link → the id is the …/archives/<ID>/… segment.'));
    const id = (await prompt('Daily-report Slack conversation id (D…/C…/G…), or blank to set later: ')).trim();
    if (id && /^[CDG][A-Z0-9]+$/.test(id)) {
      runCap('node', [SLACK, 'nick', 'add', 'me', id, 'Daily report target']);
      cfg.dailyTarget = 'me';
      writeCfg(cfg);
      ok(`Daily report will post to "me" → ${id}`);
    } else if (id) warn('That did not look like a conversation id (expected D…/C…/G…). Skipping — set later with `cf slack`/nick add.');
  }
  return true;
}

// ---------- auth: pitch MCP ----------
function readClaudeJson() { try { return JSON.parse(fs.readFileSync(CLAUDE_JSON, 'utf8')); } catch { return {}; } }
function pitchConfigured() {
  const j = readClaudeJson();
  return !!(j.mcpServers && j.mcpServers.pitch && j.mcpServers.pitch.env && j.mcpServers.pitch.env.PITCH_API_KEY);
}
function writePitchConfig(key) {
  const j = readClaudeJson();
  if (fs.existsSync(CLAUDE_JSON)) fs.copyFileSync(CLAUDE_JSON, CLAUDE_JSON + '.cf-bak'); // backup before edit
  j.mcpServers = j.mcpServers || {};
  j.mcpServers.pitch = {
    type: 'stdio',
    command: 'npx',
    args: ['-y', PITCH_PKG],
    env: { PITCH_API_KEY: key, NPM_CONFIG_CACHE: NPM_MCP_CACHE },
  };
  fs.writeFileSync(CLAUDE_JSON, JSON.stringify(j, null, 2));
}
// Best-effort: start the MCP server over stdio and ask for its tool list to prove the key works.
function pitchHandshake(timeoutMs = 90000) {
  return new Promise((resolve) => {
    const j = readClaudeJson();
    const key = j.mcpServers?.pitch?.env?.PITCH_API_KEY;
    if (!key) return resolve({ ok: false, reason: 'not configured' });
    const child = spawn('npx', ['-y', PITCH_PKG], {
      env: { ...process.env, PITCH_API_KEY: key, NPM_CONFIG_CACHE: NPM_MCP_CACHE },
      stdio: ['pipe', 'pipe', 'pipe'],
    });
    let buf = '', done = false, tools = null, err = '';
    const finish = (res) => { if (done) return; done = true; try { child.kill('SIGKILL'); } catch {} resolve(res); };
    const timer = setTimeout(() => finish({ ok: false, reason: 'timed out (npx download or no response)' }), timeoutMs);
    const send = (o) => { try { child.stdin.write(JSON.stringify(o) + '\n'); } catch {} };
    child.stdout.on('data', (d) => {
      buf += d.toString();
      let nl;
      while ((nl = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, nl).trim(); buf = buf.slice(nl + 1);
        if (!line) continue;
        let msg; try { msg = JSON.parse(line); } catch { continue; }
        if (msg.id === 1 && msg.result) { send({ jsonrpc: '2.0', method: 'notifications/initialized' }); send({ jsonrpc: '2.0', id: 2, method: 'tools/list', params: {} }); }
        if (msg.id === 2) {
          clearTimeout(timer);
          if (msg.result && Array.isArray(msg.result.tools)) { tools = msg.result.tools.length; finish({ ok: true, tools }); }
          else finish({ ok: false, reason: msg.error ? (msg.error.message || JSON.stringify(msg.error)) : 'no tools returned' });
        }
      }
    });
    child.stderr.on('data', (d) => { err += d.toString(); });
    child.on('error', (e) => finish({ ok: false, reason: e.message }));
    child.on('exit', (code) => finish({ ok: false, reason: `server exited (code ${code})${err ? ': ' + err.trim().split('\n').pop() : ''}` }));
    send({ jsonrpc: '2.0', id: 1, method: 'initialize', params: { protocolVersion: '2024-11-05', capabilities: {}, clientInfo: { name: 'cf-doctor', version: '1.0' } } });
  });
}
async function pitchAuth() {
  step('Pitch.vc MCP server');
  if (pitchConfigured()) { ok('Pitch MCP already configured in ~/.claude.json'); return true; }
  console.log('Pitch is reached through an MCP server (for Claude). You need a Pitch API key:');
  console.log(C.dim('  pitch.vc → Settings → API Keys → create one. The pitch_… token is shown only once.'));
  if (!(await confirm('Set up Pitch now?'))) { warn('Skipped Pitch. Re-run `cf connect` later to add it.'); return true; }
  const key = await promptHidden('Paste your Pitch API key (input hidden): ');
  if (!key) { warn('No key entered — skipping Pitch.'); return true; }
  if (!/^pitch_/.test(key)) warn('Key does not start with "pitch_" — saving anyway, but double-check it.');
  writePitchConfig(key);
  ok('Wrote Pitch MCP config to ~/.claude.json (backup: ~/.claude.json.cf-bak)');
  console.log(C.dim('  Verifying the key (starting the MCP server)… first run downloads the package, please wait.'));
  const h = await pitchHandshake();
  if (h.ok) ok(`Pitch key verified — ${h.tools} tools available`);
  else warn(`Could not auto-verify Pitch (${h.reason}). It will still load inside Claude Code after a restart.`);
  console.log(C.dim('  Note: MCP servers load when Claude Code starts — restart Claude Code to use Pitch tools.'));
  return true;
}

// ---------- link cf onto PATH ----------
async function linkCf() {
  step('Make the `cf` command available everywhere');
  const onPath = runCap('bash', ['-lc', 'command -v cf']).out.trim();
  if (onPath) { ok(`\`cf\` already on PATH (${onPath})`); return; }
  const candidates = ['/usr/local/bin', path.join(HOME, '.local', 'bin')];
  for (const dir of candidates) {
    try {
      fs.mkdirSync(dir, { recursive: true });
      const link = path.join(dir, 'cf');
      if (fs.existsSync(link)) fs.rmSync(link, { force: true });
      fs.symlinkSync(SELF, link);
      ok(`Linked \`cf\` → ${link}`);
      if (dir.endsWith('.local/bin')) warn(`Make sure ${dir} is on your PATH (e.g. add it in ~/.zshrc).`);
      return;
    } catch { /* try next */ }
  }
  warn(`Could not link automatically. Run cf via:  node ${SELF} <command>`);
}

// ---------- doctor ----------
async function doctor() {
  console.log(C.b('\ncf doctor — checking all integrations (read-only)\n'));
  let allGood = true;

  process.stdout.write('union.vc … ');
  if (!fs.existsSync(UNION)) { bad('skills not installed — run `cf connect`'); allGood = false; }
  else if (unionWorks()) ok('calendar pull works');
  else { bad('not working — run `cf connect` or `node union_calendar.mjs login`'); allGood = false; }

  process.stdout.write('Slack    … ');
  const who = slackWhoami();
  if (!fs.existsSync(SLACK)) { bad('skills not installed — run `cf connect`'); allGood = false; }
  else if (who && who.ok) ok(`auth.test OK (${who.user} @ ${who.team})`);
  else { bad('not working — run `cf connect` or `node slack.mjs auth`'); allGood = false; }

  process.stdout.write('Pitch    … ');
  if (!pitchConfigured()) { warn('not configured (optional) — run `cf connect` to add a key'); }
  else {
    console.log(C.dim('configured; verifying (may download on first run)…'));
    const h = await pitchHandshake();
    if (h.ok) ok(`Pitch MCP OK — ${h.tools} tools`);
    else warn(`configured but could not auto-verify (${h.reason})`);
  }

  process.stdout.write('cf PATH  … ');
  const cfOnPath = runCap('bash', ['-lc', 'command -v cf']).out.trim();
  if (cfOnPath) ok(`on PATH (${cfOnPath})`);
  else { warn('`cf` is NOT on PATH — the knowledge/mentor-match/roulette skills call bare `cf` and will fail. Run `cf connect` (links it) or add it yourself.'); }

  process.stdout.write('workspace… ');
  ok(`CF_HOME → ${CF_HOME}${CF_HOME === path.join(HOME, '.cf-helpers') ? C.dim(' (global)') : C.dim(' (project-local)')}`);

  console.log(C.dim('\nGmail: assumed already integrated (the report writes an HTML file you paste into Gmail).'));
  console.log(allGood ? C.g('\nAll required integrations are working. You\'re ready to work.') : C.y('\nSome integrations need attention — see above.'));
  return allGood;
}

// ---------- report / daily ----------
function generateReport() {
  fs.mkdirSync(REPORT_DIR, { recursive: true });
  const cfg = readCfg();
  const tz = cfg.tz || 'America/Chicago';
  if (!fs.existsSync(MENTOR)) { bad('skills not installed — run `cf connect`'); return null; }
  const r = runCap('node', [MENTOR, '--out-dir', REPORT_DIR, '--tz', tz]);
  if (r.err) process.stderr.write(r.err); // the human-readable preview
  if (!r.ok) { bad('report generation failed (union.vc session may have expired — run `cf connect`)'); return null; }
  let summary = {};
  try { summary = JSON.parse(r.out.trim().split('\n').pop()); } catch {}
  return summary;
}
async function cmdReport() {
  const s = generateReport();
  if (!s) process.exit(1);
  ok(`Report ready: ${s.openSessions} open sessions, ${s.openSlots} slots → ${REPORT_DIR}/latest.slack.md`);
}
async function cmdDaily() {
  // Non-interactive: generate, then push to the configured target. Used by the launchd job.
  const s = generateReport();
  if (!s) process.exit(1);
  const cfg = readCfg();
  const target = cfg.dailyTarget || 'me';
  const file = path.join(REPORT_DIR, 'latest.slack.md');
  const r = runCap('node', [SLACK, 'dm', target, '--file', file]);
  process.stdout.write(r.out);
  if (!r.ok) { bad(`Slack push failed: ${(r.err || '').trim() || 'unknown error'}`); process.exit(1); }
  ok(`Daily report pushed to "${target}" (${s.openSessions} sessions, ${s.openSlots} slots).`);
}

// ---------- mentors CSV (master list) ----------
// Minimal RFC-4180-ish CSV parser: handles BOM, quoted fields, embedded commas + newlines,
// and "" inside quoted strings. Pure Node, no deps.
function parseCsv(text) {
  if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1); // strip BOM (the CF export has one)
  const rows = [];
  let row = [], field = '', inQ = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (inQ) {
      if (c === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else inQ = false; }
      else field += c;
    } else {
      if (c === '"') inQ = true;
      else if (c === ',') { row.push(field); field = ''; }
      else if (c === '\r') { /* skip */ }
      else if (c === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
      else field += c;
    }
  }
  if (field !== '' || row.length) { row.push(field); rows.push(row); }
  return rows;
}
function csvToObjects(text) {
  const rows = parseCsv(text);
  if (!rows.length) return [];
  const headers = rows[0].map((h) => h.trim());
  const out = [];
  for (const r of rows.slice(1)) {
    if (r.every((x) => x === '')) continue;
    const o = {};
    for (let i = 0; i < headers.length; i++) o[headers[i]] = (r[i] || '').trim();
    out.push(o);
  }
  return out;
}
function loadMentors() {
  const cfg = readCfg();
  if (!cfg.mentorsCsv) return null;
  if (!fs.existsSync(cfg.mentorsCsv)) return null;
  return csvToObjects(fs.readFileSync(cfg.mentorsCsv, 'utf8'));
}
function thisWeeksHosts() {
  try {
    const files = fs.readdirSync(REPORT_DIR)
      .filter((f) => /^mentor-slots-\d{4}-\d{2}-\d{2}\.json$/.test(f))
      .sort().reverse();
    if (!files.length) return new Set();
    const j = JSON.parse(fs.readFileSync(path.join(REPORT_DIR, files[0]), 'utf8'));
    const hosts = (j.sessions || []).map((s) => (s.host || '').toLowerCase().trim()).filter(Boolean);
    return new Set(hosts);
  } catch { return new Set(); }
}
function isActive(m) {
  return /active/i.test(m['Status'] || '') &&
         /checked|yes|true|1|y/i.test(m['Active in Union'] || '');
}
// Whitelist the fields that leave this function — explicitly excludes Email, demographics,
// and other PII columns. Callers (incl. Claude) get only match-relevant fields.
function publicMentor(m, extra) {
  return Object.assign({
    name: m['Name'],
    first_name: m['First Name'],
    title: m['Title'],
    current_company: m['Current Company'],
    city: m['City'],
    industry: m['Industry'],
    specialties: m['Specialties'],
    technologies: m['Technologies'],
    stage: m['Stage'],
    product_type: m['Product Type'],
    product_stage: m['ProductStage'],
    preferred_customer: m['Preferred Customer Segment(s)'],
    mentor_bio: (m['Mentor Bio'] || '').slice(0, 320),
    session_description: (m['Session Description'] || '').slice(0, 320),
    union_link: m['Union Link'],
    linkedin: m['LinkedIn'],
    website: m['Website'],
    investor: m['Investor?'],
    investor_type: m['Investor Type'],
  }, extra || {});
}

function mentorsShow() {
  const cfg = readCfg();
  if (!cfg.mentorsCsv) { warn('No mentors CSV configured. Run `cf connect` or `cf mentors set <path>`.'); return; }
  const exists = fs.existsSync(cfg.mentorsCsv);
  console.log(`Path:   ${cfg.mentorsCsv}  (${exists ? 'exists' : 'MISSING'})`);
  if (!exists) return;
  const rows = csvToObjects(fs.readFileSync(cfg.mentorsCsv, 'utf8'));
  const active = rows.filter(isActive);
  console.log(`Total:  ${rows.length} rows · Active-in-Union: ${active.length}`);
  console.log(`Schema: ${Object.keys(rows[0] || {}).length} columns`);
}
function mentorsSet(p) {
  if (!p) { bad('Usage: cf mentors set <path-to-csv>'); process.exit(2); }
  const abs = path.resolve(p);
  if (!fs.existsSync(abs)) { bad(`File not found: ${abs}`); process.exit(1); }
  const cfg = readCfg(); cfg.mentorsCsv = abs; writeCfg(cfg);
  ok(`Mentors CSV path saved: ${abs}`);
  mentorsShow();
}
// Normalize a display name for matching: drop parentheticals ("Rudolf (Rudy) Mirran" → "rudolf
// mirran"), strip punctuation, lowercase, collapse spaces. Bridges union.vc host names ↔ CSV names.
function normName(s) {
  return String(s || '').toLowerCase().replace(/\([^)]*\)/g, ' ').replace(/[^a-z\s]/g, ' ').replace(/\s+/g, ' ').trim();
}
// Resolve a (possibly differently-formatted) name to master-CSV rows. Used by the skills to turn a
// union.vc office-hours host into their CSV profile reliably, instead of brittle substring matching.
function mentorsFind(args) {
  const asJson = args.includes('--json');
  const name = args.filter((a) => !a.startsWith('--')).join(' ');
  if (!name) { bad('Usage: cf mentors find <name> [--json]'); process.exit(2); }
  const mentors = loadMentors();
  if (!mentors) { bad('No mentors CSV configured. Run `cf connect` or `cf mentors set <path>`.'); process.exit(1); }
  const q = normName(name); const qp = q.split(' '); const qLast = qp[qp.length - 1]; const qFirst = qp[0] || '';
  const scored = [];
  for (const m of mentors) {
    const nm = normName(m['Name']); if (!nm) continue;
    const p = nm.split(' '); const last = p[p.length - 1]; const first = p[0] || '';
    let score = 0;
    if (nm === q) score = 100;
    else if (last === qLast && first[0] === qFirst[0]) score = 80;
    else if (nm.includes(q) || q.includes(nm)) score = 60;
    else if (last === qLast) score = 40;
    if (score > 0) scored.push(publicMentor(m, { score, active: isActive(m), csv_name: m['Name'] }));
  }
  scored.sort((a, b) => b.score - a.score);
  const top = scored.slice(0, 5);
  if (asJson) { process.stdout.write(JSON.stringify(top, null, 2) + '\n'); return; }
  if (!top.length) { console.log('(no match)'); return; }
  for (const m of top) console.log(`${String(m.score).padStart(3)}  ${m.csv_name} — ${m.title || '—'} @ ${m.current_company || '—'} (${m.city || '—'})${m.active ? '' : '  [inactive]'}`);
}
function mentorsSearch(args) {
  const mentors = loadMentors();
  if (!mentors) { bad('No mentors CSV configured. Run `cf connect` or `cf mentors set <path>`.'); process.exit(1); }
  let tags = [], kws = [], limit = 8, excludeHosting = false, asJson = false;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--tags') tags = (args[++i] || '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);
    else if (a === '--keywords') kws = (args[++i] || '').split(',').map((s) => s.trim().toLowerCase()).filter(Boolean);
    else if (a === '--limit') limit = parseInt(args[++i], 10) || 8;
    else if (a === '--not-hosting-this-week') excludeHosting = true;
    else if (a === '--json') asJson = true;
  }
  const hosts = excludeHosting ? thisWeeksHosts() : new Set();
  const scored = [];
  for (const m of mentors) {
    if (!isActive(m)) continue;
    if (hosts.has((m['Name'] || '').toLowerCase().trim())) continue;
    const f = {
      industry: (m['Industry'] || '').toLowerCase(),
      specialties: (m['Specialties'] || '').toLowerCase(),
      technologies: (m['Technologies'] || '').toLowerCase(),
      disliked: (m['DislikedTech'] || '').toLowerCase(),
      bio: (m['Mentor Bio'] || '').toLowerCase(),
      session: (m['Session Description'] || '').toLowerCase(),
      title: (m['Title'] || '').toLowerCase(),
      company: (m['Current Company'] || '').toLowerCase(),
      preferred: (m['Preferred Customer Segment(s)'] || '').toLowerCase(),
    };
    let score = 0;
    const why = [];
    for (const t of tags) {
      let hit = false;
      if (f.specialties.includes(t)) { score += 3; why.push(`spec:${t}`); hit = true; }
      if (f.technologies.includes(t)) { score += 3; why.push(`tech:${t}`); hit = true; }
      if (f.industry.includes(t))    { score += 2; why.push(`ind:${t}`);  hit = true; }
      if (!hit && f.bio.includes(t)) { score += 1; why.push(`bio:${t}`); }
      if (f.disliked.includes(t))    { score -= 3; why.push(`disliked:${t}`); }
    }
    for (const k of kws) {
      if (f.bio.includes(k))      { score += 2; why.push(`bio:${k}`); }
      if (f.session.includes(k))  { score += 2; why.push(`session:${k}`); }
      if (f.title.includes(k))    { score += 1; why.push(`title:${k}`); }
      if (f.company.includes(k))  { score += 1; why.push(`co:${k}`); }
      if (f.preferred.includes(k)){ score += 1; why.push(`pref:${k}`); }
    }
    if (score <= 0) continue;
    scored.push(publicMentor(m, { score, match_reasons: why.slice(0, 8) }));
  }
  scored.sort((a, b) => b.score - a.score);
  const top = scored.slice(0, limit);
  if (asJson) { process.stdout.write(JSON.stringify(top, null, 2) + '\n'); return; }
  for (const m of top) {
    console.log(`${String(m.score).padStart(3)}  ${m.name} — ${m.title || '(no title)'} @ ${m.current_company || '—'}  (${m.city || '—'})`);
    console.log(`     ${(m.match_reasons || []).join(', ')}`);
  }
  if (!top.length) console.log('(no matches)');
}
async function setupMentors() {
  step('Master mentor list (CSV)');
  const cfg = readCfg();
  if (cfg.mentorsCsv && fs.existsSync(cfg.mentorsCsv)) {
    try { const rows = csvToObjects(fs.readFileSync(cfg.mentorsCsv, 'utf8'));
      ok(`Configured (${rows.length} rows) → ${cfg.mentorsCsv}`); return;
    } catch { /* fall through and re-prompt */ }
  }
  console.log('Used by cf-mentor-match for the "Off-hours mentor ideas" section, and by');
  console.log('cf-pitch-roulette for per-company suggestions.');
  console.log(C.y('  Privacy note:') + ' this CSV typically has PII columns (emails, demographics).');
  console.log(C.dim('  The skills read only match-relevant fields; nothing from this file is ever'));
  console.log(C.dim('  committed to a repo or sent to Slack/Pitch.'));
  const p = (await prompt('Path to your CF master mentor CSV (or blank to skip): ')).trim();
  if (!p) { warn('Skipped — off-hours suggestions will be unavailable until you set this.'); return; }
  const abs = path.resolve(p.replace(/^~/, HOME));
  if (!fs.existsSync(abs)) { bad(`File not found: ${abs} — skipping.`); return; }
  const head = fs.readFileSync(abs, 'utf8').slice(0, 4096);
  if (!/Name.*Email|Active in Union|Mentor Bio/i.test(head)) {
    if (!(await confirm('That file does not look like a CF mentor CSV (no recognizable headers). Save anyway?', false))) return;
  }
  cfg.mentorsCsv = abs; writeCfg(cfg);
  const rows = csvToObjects(fs.readFileSync(abs, 'utf8'));
  ok(`Saved (${rows.length} rows).`);
}

// ---------- knowledge store ----------
function slugify(s) {
  return String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}
// Minimal frontmatter parser: extracts the YAML-ish block between leading `---` lines.
// Handles only the keys we generate (flat scalars, `tags: [a, b]` arrays, and a small
// `sources:` nested block). Anything else is returned as a raw string.
function parseFrontmatter(text) {
  const m = /^---\r?\n([\s\S]*?)\r?\n---/.exec(text);
  if (!m) return {};
  const out = {}; let nested = null;
  for (const raw of m[1].split(/\r?\n/)) {
    if (!raw.trim()) { nested = null; continue; }
    if (/^[A-Za-z_][A-Za-z0-9_]*:\s*$/.test(raw)) { // "sources:" opening a block
      nested = raw.split(':')[0].trim(); out[nested] = {}; continue;
    }
    if (nested && /^\s+\S/.test(raw)) {
      const [k, ...rest] = raw.trim().split(':'); out[nested][k.trim()] = rest.join(':').trim();
      continue;
    }
    nested = null;
    const idx = raw.indexOf(':'); if (idx < 0) continue;
    const k = raw.slice(0, idx).trim(); let v = raw.slice(idx + 1).trim();
    if (/^\[.*\]$/.test(v)) v = v.slice(1, -1).split(',').map((x) => x.trim().replace(/^["']|["']$/g, '')).filter(Boolean);
    else v = v.replace(/^["']|["']$/g, '');
    out[k] = v;
  }
  return out;
}
function knowledgeDir() { return readCfg().knowledgeDir || null; }
function knowledgeShow() {
  const dir = knowledgeDir();
  if (!dir) { warn('No knowledge directory set. Run: cf knowledge set <path>'); return; }
  const exists = fs.existsSync(dir);
  console.log(`Path:   ${dir}  (${exists ? 'exists' : 'MISSING — will be created on first write'})`);
  if (!exists) return;
  let co = 0, me = 0;
  try { co = fs.readdirSync(path.join(dir, 'companies')).filter((f) => f.endsWith('.md')).length; } catch {}
  try { me = fs.readdirSync(path.join(dir, 'mentors')).filter((f) => f.endsWith('.md')).length; } catch {}
  console.log(`Counts: ${co} companies · ${me} mentors`);
}
function knowledgeSet(p) {
  if (!p) { bad('Usage: cf knowledge set <path>'); process.exit(2); }
  const abs = path.resolve(p.replace(/^~/, HOME));
  fs.mkdirSync(path.join(abs, 'companies'), { recursive: true });
  fs.mkdirSync(path.join(abs, 'mentors'), { recursive: true });
  const cfg = readCfg(); cfg.knowledgeDir = abs; writeCfg(cfg);
  ok(`Knowledge directory: ${abs}`);
  knowledgeShow();
}
function knowledgePath(args) {
  const slug = args.find((a) => !a.startsWith('--'));
  const tIdx = args.indexOf('--type'); const type = tIdx >= 0 ? args[tIdx + 1] : null;
  if (!slug) { bad('Usage: cf knowledge path <slug-or-name> --type co|mentor'); process.exit(2); }
  const dir = knowledgeDir(); if (!dir) { bad('Knowledge dir not set'); process.exit(1); }
  const folder = type === 'mentor' ? 'mentors' : 'companies';
  console.log(path.join(dir, folder, slugify(slug) + '.md'));
}
function knowledgeList(args) {
  const dir = knowledgeDir(); if (!dir) { bad('Knowledge dir not set'); process.exit(1); }
  let type = null, tag = null, staleDays = null, asJson = false;
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (a === '--type') type = (args[++i] || '').toLowerCase();
    else if (a === '--tag') tag = (args[++i] || '').toLowerCase();
    else if (a === '--stale') staleDays = parseInt(args[++i], 10);
    else if (a === '--json') asJson = true;
  }
  const buckets = [];
  if (!type || type.startsWith('co')) buckets.push({ folder: 'companies', kind: 'company' });
  if (!type || type.startsWith('me')) buckets.push({ folder: 'mentors', kind: 'mentor' });
  const now = Date.now();
  const rows = [];
  for (const b of buckets) {
    const sub = path.join(dir, b.folder);
    if (!fs.existsSync(sub)) continue;
    for (const f of fs.readdirSync(sub).filter((x) => x.endsWith('.md'))) {
      const p = path.join(sub, f);
      let fm = {};
      try { fm = parseFrontmatter(fs.readFileSync(p, 'utf8')); } catch {}
      const tags = Array.isArray(fm.tags) ? fm.tags : (typeof fm.tags === 'string' ? [fm.tags] : []);
      if (tag && !tags.some((t) => String(t).toLowerCase().includes(tag))) continue;
      if (staleDays != null) {
        const ts = Date.parse(fm.refreshedAt || ''); if (!isFinite(ts) || (now - ts) < staleDays * 86400000) continue;
      }
      rows.push({ type: b.kind, slug: f.replace(/\.md$/, ''), name: fm.name || '', refreshedAt: fm.refreshedAt || '', tags, path: p });
    }
  }
  rows.sort((a, b) => (a.type === b.type ? a.slug.localeCompare(b.slug) : a.type.localeCompare(b.type)));
  if (asJson) { process.stdout.write(JSON.stringify(rows, null, 2) + '\n'); return; }
  if (!rows.length) { console.log('(no entries)'); return; }
  for (const r of rows) {
    const tagStr = (r.tags || []).slice(0, 4).join(', ');
    console.log(`${r.type.padEnd(7)}  ${r.slug.padEnd(28)}  ${r.refreshedAt.slice(0, 10).padEnd(10)}  ${r.name}${tagStr ? '  · ' + tagStr : ''}`);
  }
  console.log(`\n${rows.length} entries`);
}
async function setupKnowledge() {
  step('Local knowledge directory');
  const cfg = readCfg();
  if (cfg.knowledgeDir && fs.existsSync(cfg.knowledgeDir)) {
    ok(`Configured → ${cfg.knowledgeDir}`); return;
  }
  console.log('Where should the local CF knowledge base live? Examples:');
  console.log(C.dim('  ~/cf-knowledge                  (simple)'));
  console.log(C.dim('  ~/Obsidian/CF                   (inside an Obsidian vault)'));
  console.log(C.dim('  ~/Library/Mobile Documents/.../CF  (iCloud-synced)'));
  console.log(C.dim('  Leave blank to skip — set later with `cf knowledge set <path>`.'));
  const p = (await prompt('Knowledge dir: ')).trim();
  if (!p) { warn('Skipped — cf-knowledge skill will be inert until you run `cf knowledge set <path>`.'); return; }
  const abs = path.resolve(p.replace(/^~/, HOME));
  fs.mkdirSync(path.join(abs, 'companies'), { recursive: true });
  fs.mkdirSync(path.join(abs, 'mentors'), { recursive: true });
  cfg.knowledgeDir = abs; writeCfg(cfg);
  ok(`Saved: ${abs}`);
}

// ---------- project workspace ----------
// `cf init [dir]` scaffolds a self-contained workspace so memory/reports/augmentation live in the
// project (not ~/.cf-helpers). After init, any cf/skill run from inside `dir` uses this workspace.
function cmdInit(args) {
  const root = path.resolve(args.find((a) => !a.startsWith('--')) || process.cwd());
  const home = path.join(root, '.cf-helpers');
  const mem = path.join(root, 'memory');
  const data = path.join(root, 'data');
  fs.mkdirSync(path.join(home, 'reports'), { recursive: true });
  fs.mkdirSync(path.join(home, 'augmentation'), { recursive: true });
  fs.mkdirSync(path.join(mem, 'companies'), { recursive: true });
  fs.mkdirSync(path.join(mem, 'mentors'), { recursive: true });
  fs.mkdirSync(data, { recursive: true });
  const cfgPath = path.join(home, 'config.json');
  // Write directly to the new home (CF_HOME for THIS process was resolved before the home existed).
  let cfg = {};
  try { cfg = JSON.parse(fs.readFileSync(cfgPath, 'utf8')); } catch {}
  cfg.knowledgeDir = cfg.knowledgeDir || mem;
  cfg.tz = cfg.tz || 'America/Chicago';
  fs.writeFileSync(cfgPath, JSON.stringify(cfg, null, 2) + '\n');
  ok(`Initialized CF workspace at ${root}`);
  console.log(`  home:    ${home}  ${C.dim('(config.json, reports/, augmentation/)')}`);
  console.log(`  memory:  ${mem}  ${C.dim('(companies/, mentors/) — the durable local memory')}`);
  console.log(`  data:    ${data}  ${C.dim('(drop your mentor CSV here, then: cf mentors set <file>)')}`);
  console.log(C.dim('  Any `cf` or skill run from inside this dir now uses THIS workspace, not the global one.'));
}
function cmdConfigDump() { process.stdout.write(JSON.stringify({ home: CF_HOME, ...readCfg() }, null, 2) + '\n'); }

// ---------- launchd daily ----------
const PLIST_LABEL = 'com.cfhelpers.daily';
const PLIST_PATH = path.join(HOME, 'Library', 'LaunchAgents', PLIST_LABEL + '.plist');
const DAILY_SH = path.join(REPO, 'scripts', 'daily_report.sh');
function installDaily(hhmm) {
  const m = /^(\d{1,2}):(\d{2})$/.exec(hhmm || '07:00');
  if (!m) { bad('Time must be HH:MM (24-hour), e.g. 07:00'); process.exit(2); }
  const hour = parseInt(m[1], 10), minute = parseInt(m[2], 10);
  const log = path.join(CF_HOME, 'daily.log');
  fs.mkdirSync(CF_HOME, { recursive: true });
  fs.mkdirSync(path.dirname(PLIST_PATH), { recursive: true });
  const plist = `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${PLIST_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>${DAILY_SH}</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>${hour}</integer><key>Minute</key><integer>${minute}</integer></dict>
  <key>StandardOutPath</key><string>${log}</string>
  <key>StandardErrorPath</key><string>${log}</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
`;
  fs.writeFileSync(PLIST_PATH, plist);
  runCap('launchctl', ['unload', PLIST_PATH]); // ignore errors if not loaded
  const r = runCap('launchctl', ['load', PLIST_PATH]);
  if (!r.ok) { bad(`launchctl load failed: ${(r.err || '').trim()}`); process.exit(1); }
  ok(`Daily report scheduled for ${String(hour).padStart(2, '0')}:${String(minute).padStart(2, '0')} every day.`);
  console.log(C.dim(`  plist: ${PLIST_PATH}`));
  console.log(C.dim(`  log:   ${log}`));
  console.log(C.dim('  It posts to your configured Slack target. Change it any time with `cf install-daily HH:MM`.'));
}
function uninstallDaily() {
  if (!fs.existsSync(PLIST_PATH)) { warn('No daily job installed.'); return; }
  runCap('launchctl', ['unload', PLIST_PATH]);
  fs.rmSync(PLIST_PATH, { force: true });
  ok('Daily report job removed.');
}

// ---------- connect ----------
async function connect(force) {
  console.log(C.b('\n╭─ cf connect — Capital Factory helpers setup ─╮'));
  console.log(C.dim('This installs the skills, signs you in to union.vc + Slack, sets up Pitch, and tests it all.\n'));
  if (!checkNode()) process.exit(1);
  installSkills(force);
  if (!installDeps(force)) process.exit(1);
  await unionAuth();
  await slackAuth();
  await pitchAuth();
  await setupMentors();
  await setupKnowledge();
  await linkCf();
  console.log(C.b('\n── Final check ──'));
  await doctor();
  console.log(C.dim('\nNext: `cf report` (build a report), `cf daily` (build + push to Slack),'));
  console.log(C.dim('      `cf install-daily 07:00` (schedule it), `cf doctor` (re-check anytime).'));
}

// ---------- help ----------
function help() {
  console.log(`${C.b('cf')} — Capital Factory helpers

  ${C.b('cf connect')}              One-time setup: install skills, sign in (union.vc + Slack),
                          set up Pitch MCP, and test everything. ${C.dim('Run this first.')}
  ${C.b('cf init')} [dir]            Scaffold a project-local workspace (memory/, data/, .cf-helpers/)
                          so memory + reports live in the project, not ~/.cf-helpers.
  ${C.b('cf home')} / ${C.b('config')}        Print the resolved CF_HOME / merged config (debug).
  ${C.b('cf report-dir')} / ${C.b('augment-dir')}   Print (and create) the reports / augmentation dir.
  ${C.b('cf doctor')}               Re-test all integrations (read-only, no sign-in).
  ${C.b('cf report')}               Build the mentor office-hours report into <CF_HOME>/reports/.
  ${C.b('cf daily')}                Build the report AND push it to your Slack target (no Claude).
  ${C.b('cf calendar')} [args...]    Pull the union.vc calendar as JSON (forwards to union_calendar.mjs).
  ${C.b('cf slack')} <t> <msg...>    Send a Slack DM (forwards to slack.mjs dm; add --dry-run first).
  ${C.b('cf mentors')} <sub>          Master mentor CSV:
                              ${C.b('show')}             — what's configured
                              ${C.b('set')} <path>       — point at a CSV
                              ${C.b('find')} <name>      — resolve a (union.vc) name to CSV row(s) (--json)
                              ${C.b('search')} [flags]   — score+filter (--tags X,Y --keywords k1,k2
                                                  --not-hosting-this-week --limit N --json)
  ${C.b('cf knowledge')} <sub>        Local CF knowledge base:
                              ${C.b('show')}             — configured dir + counts
                              ${C.b('set')} <path>       — point at a directory
                              ${C.b('list')} [flags]     — list entries (--type co|mentor
                                                  --tag X --stale N --json)
                              ${C.b('path')} <slug> --type co|mentor  — resolve entity file path
  ${C.b('cf install-daily')} [HH:MM]  Schedule \`cf daily\` via launchd (default 07:00, Mac).
  ${C.b('cf uninstall-daily')}      Remove the scheduled daily job.
  ${C.b('cf help')}                 This help.
`);
}

// ---------- main ----------
const [cmd, ...rest] = process.argv.slice(2);
const force = rest.includes('--force');
try {
  switch (cmd) {
    case 'connect': await connect(force); break;
    case 'init': cmdInit(rest); break;
    case 'home': console.log(CF_HOME); break;
    case 'config': cmdConfigDump(); break;
    case 'report-dir': fs.mkdirSync(REPORT_DIR, { recursive: true }); console.log(REPORT_DIR); break;
    case 'augment-dir': fs.mkdirSync(AUGMENT_DIR, { recursive: true }); console.log(AUGMENT_DIR); break;
    case 'doctor': process.exit((await doctor()) ? 0 : 1); break;
    case 'report': await cmdReport(); break;
    case 'daily': await cmdDaily(); break;
    case 'calendar':
      if (!fs.existsSync(UNION)) { bad('skills not installed — run `cf connect`'); process.exit(1); }
      process.exit(runInherit('node', [UNION, 'pull', ...rest]) ? 0 : 1); break;
    case 'slack':
      if (!fs.existsSync(SLACK)) { bad('skills not installed — run `cf connect`'); process.exit(1); }
      process.exit(runInherit('node', [SLACK, 'dm', ...rest]) ? 0 : 1); break;
    case 'mentors': {
      const sub = rest[0];
      if (sub === 'search') mentorsSearch(rest.slice(1));
      else if (sub === 'find') mentorsFind(rest.slice(1));
      else if (sub === 'set') mentorsSet(rest[1]);
      else if (sub === 'show' || !sub) mentorsShow();
      else { bad(`Unknown mentors subcommand: ${sub}`); process.exit(2); }
      break;
    }
    case 'knowledge': {
      const sub = rest[0];
      if (sub === 'set') knowledgeSet(rest[1]);
      else if (sub === 'list') knowledgeList(rest.slice(1));
      else if (sub === 'path') knowledgePath(rest.slice(1));
      else if (sub === 'show' || !sub) knowledgeShow();
      else { bad(`Unknown knowledge subcommand: ${sub}`); process.exit(2); }
      break;
    }
    case 'install-daily': installDaily(rest.find((a) => /^\d/.test(a))); break;
    case 'uninstall-daily': uninstallDaily(); break;
    case 'help': case undefined: case '--help': case '-h': help(); break;
    default: bad(`Unknown command: ${cmd}`); help(); process.exit(2);
  }
} catch (err) {
  bad(err && err.message ? err.message : String(err));
  process.exit(1);
}
